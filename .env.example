# ZeroTrustX Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Cryptography
SECRET_KEY=zerotrustx_super_secure_jwt_signing_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for prod, fallback to local SQLite for dev)
DATABASE_URL=sqlite:///./zerotrustx.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zerotrustx

# Redis (Caching, Rate Limiting, Session state)
REDIS_URL=redis://localhost:6379/0

# Kafka (Event Pipeline)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SECURITY_EVENTS=ztx-security-events
KAFKA_TOPIC_TELEMETRY=ztx-telemetry

# Default Tenant Configuration
DEFAULT_TENANT_ID=tenant-enterprise-01
DEFAULT_TENANT_NAME=Acme Cyber Defense Corp

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
